# NIDAR RescueSwarm -- operator console configuration
# Copy to frontend/.env and edit. Vite only exposes VITE_* variables.

# --- backend ----------------------------------------------------------------
# Left unset, the console talks to the same origin it was served from, which is
# what you want when the backend serves it at /console. The dev server proxies
# /api and /ws to VITE_BACKEND_ORIGIN (see vite.config.ts).
# VITE_API_BASE=/api/v1
# VITE_WS_BASE=ws://gcs.local:8000
# VITE_BACKEND_ORIGIN=http://127.0.0.1:8000     # dev proxy target only

# --- basemap ----------------------------------------------------------------
# Which basemap the console starts on:
#   local      tiles from this ground station -- works with no network  (default)
#   satellite  live satellite imagery          -- needs the Internet
#   street     live street map                 -- needs the Internet
#   none       coordinate grid only
#
# A mission must not depend on the Internet, so `local` is the default and the
# operator can switch at any time. Whatever you choose, aircraft, sectors,
# geofences and survivors always render -- imagery is never required to fly.
VITE_BASEMAP=local

# Where the cached tiles are served from. The backend mounts ./tiles at /tiles
# automatically when that directory exists.
VITE_LOCAL_TILE_URL=/tiles/{z}/{x}/{y}.jpg
# The deepest zoom you actually cached. Set this to what you downloaded, or the
# map will request tiles that do not exist and show gaps.
VITE_LOCAL_TILE_MAXZOOM=18

# Online sources, used only when the operator selects them. Check each
# provider's terms before relying on, or caching, their tiles.
# VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# VITE_STREET_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
