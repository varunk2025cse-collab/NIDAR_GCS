# NIDAR RescueSwarm GCS backend -- environment configuration
# Copy to .env and edit for the real ground station.
#
# Nested settings use a double underscore, e.g. SAFETY__BATTERY_WARNING_PCT.

# --- environment ------------------------------------------------------------
ENVIRONMENT=development          # development | bench | field | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
LOG_DIR=logs

# --- database (local; no cloud service is used) ------------------------------
DATABASE_URL=postgresql+asyncpg://gcs:gcs@localhost:5432/nidar_gcs
DB_POOL_SIZE=10
DB_ECHO=false

# --- security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-BEFORE-ANY-REAL-FLIGHT
ACCESS_TOKEN_TTL_MINUTES=720
CORS_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_COMMANDS_PER_MINUTE=60

# Per-drone shared secrets for companion computers posting detections and
# delivery confirmations. A key is bound to one aircraft, so a compromised
# scout cannot post events claiming to be another airframe.
# Generate one per aircraft with: python -c "import secrets; print(secrets.token_urlsafe(32))"
COMPANION_API_KEYS={"D1": "REPLACE-WITH-D1-KEY", "D2": "REPLACE-WITH-D2-KEY", "D3": "REPLACE-WITH-D3-KEY"}

# --- fleet ------------------------------------------------------------------
FLEET_CONFIG_FILE=config/fleet.yaml
CAMERA_CONFIG_FILE=config/cameras.yaml
# Absent = UNCALIBRATED = delivery dispatch blocked. Produce it with:
#   python -m scripts.calibrate_energy compute --airframe D3-1 --by "name"
ENERGY_MODEL_FILE=config/energy_model.yaml

# Endpoint overrides for the real radio setup. Identity (role, system id)
# always comes from fleet.yaml so an env var cannot re-point a role at the
# wrong airframe.
# DRONE_D1_CONNECTION=udpin://0.0.0.0:14541
# DRONE_D2_CONNECTION=udpin://0.0.0.0:14542
# DRONE_D3_CONNECTION=udpin://0.0.0.0:14543

# Hardware UIDs, once read from GET /api/v1/drones/registry after first contact.
# DRONE_D1_HARDWARE_UID=
# DRONE_D2_HARDWARE_UID=
# DRONE_D3_HARDWARE_UID=

# --- link behaviour ---------------------------------------------------------
CONNECTION__HEARTBEAT_DEGRADED_S=3.0
CONNECTION__HEARTBEAT_LOST_S=10.0
CONNECTION__CONNECT_TIMEOUT_S=30.0
CONNECTION__IDENTITY_PROBE_TIMEOUT_S=15.0
# Verify the system id on the wire before MAVSDK attaches. Keep this on for
# multi-drone operation; it is what stops D3 commands reaching D1.
CONNECTION__REQUIRE_IDENTITY_PROBE=true
CONNECTION__FAIL_CLOSED_ON_IDENTITY=true
CONNECTION__GCS_SYSTEM_ID=245
CONNECTION__GCS_COMPONENT_ID=190
# Leave unset to use the binary bundled with the mavsdk package.
# CONNECTION__MAVSDK_SERVER_BIN=/usr/local/bin/mavsdk_server

# --- telemetry rates (Hz; keep modest for a real RF link) --------------------
TELEMETRY_RATES__POSITION_HZ=4.0
TELEMETRY_RATES__VELOCITY_HZ=2.0
TELEMETRY_RATES__ATTITUDE_HZ=2.0
TELEMETRY_RATES__BATTERY_HZ=1.0
TELEMETRY_RATES__GPS_INFO_HZ=1.0
TELEMETRY_RATES__HEALTH_HZ=1.0

# --- telemetry freshness (seconds) ------------------------------------------
# Older than *_FRESH_S is reported STALE; older than *_STALE_S becomes NO_DATA.
FRESHNESS__POSITION_FRESH_S=2.0
FRESHNESS__POSITION_STALE_S=10.0
FRESHNESS__BATTERY_FRESH_S=5.0
FRESHNESS__BATTERY_STALE_S=30.0

# --- safety thresholds (advisory; PX4 owns the aircraft failsafes) ----------
SAFETY__BATTERY_WARNING_PCT=40
SAFETY__BATTERY_CRITICAL_PCT=25
SAFETY__BATTERY_EMERGENCY_PCT=15
SAFETY__BATTERY_MIN_FOR_TAKEOFF_PCT=50
SAFETY__BATTERY_MIN_FOR_DELIVERY_PCT=45
SAFETY__BATTERY_RESERVE_PCT=25
# NOTE: the delivery energy model now lives in config/energy_model.yaml and is
# produced by scripts/calibrate_energy.py from measured flights. These two
# values remain only for reference; the delivery feasibility check does not
# read them. While config/energy_model.yaml is absent the model is
# UNCALIBRATED and delivery dispatch is refused.
SAFETY__BATTERY_PCT_PER_KM=4.0
SAFETY__BATTERY_PCT_PER_MINUTE_HOVER=1.2
SAFETY__MIN_SATELLITES=8
SAFETY__MIN_GPS_FIX_TYPE=3
SAFETY__GEOFENCE_WARNING_MARGIN_M=25
SAFETY__MISSION_MAX_DURATION_S=1800
SAFETY__MISSION_WARNING_REMAINING_S=300
SAFETY__MAX_DELIVERY_DISTANCE_M=3000
SAFETY__DELIVERY_CRUISE_SPEED_MPS=8.0
SAFETY__COMMAND_REQUIRES_TELEMETRY_AGE_S=5.0

# --- survivor detection -----------------------------------------------------
SURVIVOR__MIN_CONFIDENCE=0.55
SURVIVOR__AUTO_CONFIRM_CONFIDENCE=0.85
SURVIVOR__DUPLICATE_RADIUS_M=25
SURVIVOR__DUPLICATE_WINDOW_S=900
SURVIVOR__CORROBORATIONS_FOR_CONFIRM=2
SURVIVOR__MAX_AUTO_CONFIRM_ACCURACY_M=30
SURVIVOR__MAX_DETECTION_AGE_S=120

# --- delivery ---------------------------------------------------------------
# What physically attests that a payload was released.
# OPERATOR requires a human to confirm; switch to PAYLOAD_MECHANISM or SENSOR
# once that hardware reports in. Nothing marks a delivery complete without one.
DELIVERY_CONFIRMATION_SOURCE=OPERATOR
DELIVERY_CONFIRMATION_TIMEOUT_S=120
# Launching an aircraft automatically on survivor confirmation. Off by default.
AUTO_DISPATCH_DELIVERIES=false
# Converts the blocking UNCALIBRATED check into a warning. Set true ONLY for
# bench work where no aircraft can physically launch. Never in the field.
SAFETY__ALLOW_UNCALIBRATED_DELIVERY=false

# --- command lifecycle ------------------------------------------------------
COMMAND__ARM_TIMEOUT_S=15
COMMAND__TAKEOFF_TIMEOUT_S=60
COMMAND__LAND_TIMEOUT_S=180
COMMAND__RTL_TIMEOUT_S=30
COMMAND__VERIFICATION_TIMEOUT_S=20

# --- engines ----------------------------------------------------------------
SAFETY_ENGINE_INTERVAL_S=1.0
FLEET_BROADCAST_INTERVAL_S=1.0
TELEMETRY_PERSIST_INTERVAL_S=1.0
TELEMETRY_PERSIST_MIN_DISTANCE_M=2.0
SYSTEM_HEALTH_INTERVAL_S=5.0

# Set false only for offline development of non-flight code paths. In the
# field this must be true, or the backend talks to no aircraft at all.
ENABLE_DRONE_CONNECTIONS=true
ENABLE_SAFETY_ENGINE=true
